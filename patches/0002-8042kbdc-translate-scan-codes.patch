+
 void kbdc8042_device::at_8042_check_keyboard()
 {
 	if (!m_keyboard.received && !m_mouse.received && m_keyboard_dev.found())
 	{
 		int data = m_keyboard_dev->read();
-		if (data)
-			at_8042_receive(data);
+
+		if (!data)
+			return;
+
+		if (BIT(m_command, 6))
+		{
+			// a break is a prefix followed by the code, and becomes one byte
+			if (data == 0xf0)
+			{
+				m_translate_break = true;
+				return;
+			}
+
+			if (data < 0x84)
+			{
+				data = m_translate[data] | (m_translate_break ? 0x80 : 0x00);
+				m_translate_break = false;
+			}
+		}
+
+		at_8042_receive(data);
 	}
 }
 
