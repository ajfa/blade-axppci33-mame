+/*
+ * Pages are 8K and the palcode services translation buffer misses: on a miss the
+ * access is abandoned, the faulting address is recorded and the appropriate
+ * palcode entry is taken. The handler writes the tag and pte and returns with
+ * hw_rei, which retries the access.
+ */
+bool alpha_ev4_device::tb_translate(tb_entry *tb, unsigned count, u64 &address, int intention, u64 &fault)
+{
+	u64 const vpn = address >> 13;
+	bool const user = m_ibx[IBX_PS] & IBX_PS_R_CM;
+	bool const write = (intention == device_memory_interface::TR_WRITE);
+
+	fault = 0;
+
+	for (unsigned i = 0; i < count; i++)
+		if (tb[i].valid && (tb[i].tag >> 13) == vpn)
+		{
+			u64 const pte = tb[i].pte;
+
+			// access violation takes precedence over the fault-on bits
+			u64 const enable = write
+				? (user ? PTE_UWE : PTE_KWE)
+				: (user ? PTE_URE : PTE_KRE);
+
+			if (!(pte & enable))
+				fault = MM_CSR_ACV;
+			else if (write && (pte & PTE_FOW))
+				fault = MM_CSR_FOW;
+			else if (!write && (pte & PTE_FOR))
+				fault = MM_CSR_FOR;
+
+			if (fault)
+				return false;
+
+			address = ((pte >> 32) << 13) | (address & 0x1fff);
+
+			return true;
+		}
+
+	return false;
+}
+
+void alpha_ev4_device::tb_load(tb_entry *tb, unsigned count, unsigned &next, u64 pte)
+{
+	// an invalid pte just displaces the entry
+	tb[next].tag = m_tb_tag;
+	tb[next].pte = pte;
+	tb[next].valid = BIT(pte, 0);
+
+	next = (next + 1) % count;
+}
+
+void alpha_ev4_device::exception(u16 entry)
+{
+	m_lock_flag = false;
+
+	m_ibx[IBX_EXC_ADDR] = m_pc_insn;
+	if (m_pal_mode)
+		m_ibx[IBX_EXC_ADDR] |= 1;
+
+	m_pal_mode = true;
+	m_pc = m_ibx[IBX_PAL_BASE] | entry;
+}
+
+/*
+ * Longword and quadword references must be naturally aligned; the operating
+ * system emulates the ones that are not, so hand it the address, the opcode
+ * and the target register the same way a data fault does.
+ */
+bool alpha_ev4_device::unaligned(u64 address, unsigned bytes, int intention)
+{
+	if (!(address & (bytes - 1)))
+		return false;
+
+	m_abx[ABX_VA] = address & 0x7ff'ffffffff;
+	m_abx[ABX_MM_CSR] = (intention == device_memory_interface::TR_WRITE ? MM_CSR_WR : 0)
+		| (u64(m_insn >> 26) << MM_CSR_V_OPC)
+		| (u64((m_insn >> 21) & 0x1f) << MM_CSR_V_RA);
+
+	exception(UNALIGN);
+
+	return true;
+}
