+constexpr u64 FP_SIGN     = 0x80000000'00000000ULL;
+constexpr u64 FP_SIGN_EXP = 0xfff00000'00000000ULL;
+constexpr u64 FP_TRUE     = 0x40000000'00000000ULL;
+
+// single precision operands are held in registers in double precision format
+float32_t narrow(u64 const data)
+{
+	return f64_to_f32(float64_t{ data });
+}
+
+u64 widen(float32_t const data)
+{
+	return f32_to_f64(data).v;
+}
+
+bool is_nan(u64 const data)
+{
+	return ((data & 0x7ff00000'00000000ULL) == 0x7ff00000'00000000ULL)
+		&& (data & 0x000fffff'ffffffffULL);
+}
+
+u64 compare(bool const result)
+{
+	return result ? FP_TRUE : 0;
+}
+
+u8 rounding(unsigned const mode, u64 const fpcr)
+{
+	// mode 3 takes the rounding from the control register
+	unsigned const selected = (mode == 3) ? unsigned((fpcr >> 58) & 3) : mode;
+
+	switch (selected)
+	{
+	case 0:  return softfloat_round_minMag;
+	case 1:  return softfloat_round_min;
+	case 2:  return softfloat_round_near_even;
+	default: return softfloat_round_max;
+	}
+}
+
+}
+
+/*
+ * The high half of an unaligned pair shifts by 64 when the byte offset is
+ * zero, which C++ leaves undefined and the architecture defines as zero.
+ */
+u64 shift_high_left(u64 data, unsigned byte_loc)
+{
+	return byte_loc ? (data << (64 - byte_loc * 8)) : 0;
+}
+
+u64 shift_high_right(u64 data, unsigned byte_loc)
+{
+	return byte_loc ? (data >> (64 - byte_loc * 8)) : 0;
+}
